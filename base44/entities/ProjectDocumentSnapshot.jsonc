{
  "name": "ProjectDocumentSnapshot",
  "type": "object",
  "properties": {
    "configId": {
      "type": "string",
      "title": "Configuration ID"
    },
    "documentVersion": {
      "type": "string",
      "title": "Document Version"
    },
    "generatedBy": {
      "type": "string",
      "title": "Generated By"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Generated At"
    },
    "pdfUrl": {
      "type": "string",
      "title": "PDF URL"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "success",
        "failed"
      ],
      "default": "pending",
      "title": "Status"
    },
    "pageCount": {
      "type": "number",
      "title": "Page Count"
    },
    "sectionCount": {
      "type": "number",
      "title": "Section Count"
    },
    "screenshotCount": {
      "type": "number",
      "title": "Screenshot Count"
    },
    "diagramCount": {
      "type": "number",
      "title": "Diagram Count"
    },
    "codeSnippetCount": {
      "type": "number",
      "title": "Code Snippet Count"
    },
    "fileSizeKB": {
      "type": "number",
      "title": "File Size (KB)"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "configId",
    "documentVersion",
    "generatedBy"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}