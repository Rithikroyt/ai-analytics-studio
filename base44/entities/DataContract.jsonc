{
  "name": "DataContract",
  "type": "object",
  "properties": {
    "datasetName": {
      "type": "string",
      "title": "Dataset Name"
    },
    "dataSourceId": {
      "type": "string",
      "title": "Data Source ID"
    },
    "requiredColumns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Required Columns"
    },
    "expectedTypes": {
      "type": "object",
      "title": "Expected Column Types",
      "additionalProperties": true
    },
    "allowedValues": {
      "type": "object",
      "title": "Allowed Values per Column",
      "additionalProperties": true
    },
    "missingThreshold": {
      "type": "number",
      "default": 0.1,
      "title": "Max Missing Rate (0-1)"
    },
    "duplicateThreshold": {
      "type": "number",
      "default": 0.05,
      "title": "Max Duplicate Rate (0-1)"
    },
    "validDateRange": {
      "type": "object",
      "title": "Valid Date Range",
      "additionalProperties": true
    },
    "businessRules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Business Rules"
    },
    "owner": {
      "type": "string",
      "title": "Owner Email"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "deprecated"
      ],
      "default": "draft",
      "title": "Status"
    },
    "lastValidatedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Last Validated At"
    },
    "lastValidationResult": {
      "type": "object",
      "title": "Last Validation Result",
      "additionalProperties": true
    },
    "passRate": {
      "type": "number",
      "default": 0,
      "title": "Last Pass Rate (0-100)"
    }
  },
  "required": [
    "datasetName",
    "owner"
  ]
}