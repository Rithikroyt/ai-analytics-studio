{
  "name": "GovernedMetric",
  "type": "object",
  "properties": {
    "metricName": {
      "type": "string",
      "title": "Metric Name"
    },
    "businessDefinition": {
      "type": "string",
      "title": "Business Definition"
    },
    "formula": {
      "type": "string",
      "title": "Formula"
    },
    "aggregationType": {
      "type": "string",
      "enum": [
        "sum",
        "average",
        "ratio",
        "count",
        "min",
        "max",
        "custom"
      ],
      "title": "Aggregation Type"
    },
    "sourceColumns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Source Columns"
    },
    "validDimensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Valid Dimensions"
    },
    "synonyms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Synonyms"
    },
    "domain": {
      "type": "string",
      "enum": [
        "finance",
        "growth",
        "operations",
        "quality",
        "general"
      ],
      "title": "Domain"
    },
    "certified": {
      "type": "boolean",
      "default": false,
      "title": "Certified"
    },
    "certifiedBy": {
      "type": "string",
      "title": "Certified By"
    },
    "certifiedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Certified At"
    },
    "nonAdditive": {
      "type": "boolean",
      "default": false,
      "title": "Non-Additive (cannot SUM)"
    },
    "integrityScore": {
      "type": "number",
      "default": 0,
      "title": "Integrity Score"
    }
  },
  "required": [
    "metricName",
    "formula",
    "aggregationType"
  ]
}