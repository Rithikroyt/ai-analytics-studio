{
  "name": "PipelineRun",
  "type": "object",
  "properties": {
    "pipelineName": {
      "type": "string",
      "title": "Pipeline Name"
    },
    "datasetId": {
      "type": "string",
      "title": "Dataset Name / ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "success",
        "failed",
        "partial"
      ],
      "default": "running",
      "title": "Status"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Step IDs"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Started At"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Completed At"
    },
    "durationMs": {
      "type": "number",
      "default": 0,
      "title": "Duration (ms)"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Warnings"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Errors"
    },
    "stepResults": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "title": "Step Results"
    },
    "inputRowCount": {
      "type": "number",
      "default": 0,
      "title": "Input Rows"
    },
    "qualityScore": {
      "type": "number",
      "default": 0,
      "title": "Quality Score"
    },
    "createdBy": {
      "type": "string",
      "title": "Created By"
    }
  },
  "required": [
    "pipelineName"
  ]
}