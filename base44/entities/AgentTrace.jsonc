{
  "name": "AgentTrace",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "title": "Session ID"
    },
    "agentName": {
      "type": "string",
      "title": "Agent Name"
    },
    "userEmail": {
      "type": "string",
      "title": "User Email"
    },
    "datasetName": {
      "type": "string",
      "title": "Dataset Name"
    },
    "userQuestion": {
      "type": "string",
      "title": "User Question"
    },
    "intent": {
      "type": "string",
      "title": "Intent Classified"
    },
    "domain": {
      "type": "string",
      "enum": [
        "finance",
        "growth",
        "operations",
        "quality",
        "forecast",
        "strategy",
        "general"
      ],
      "title": "Domain"
    },
    "toolsCalled": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Tools Called"
    },
    "sqlGenerated": {
      "type": "string",
      "title": "SQL Generated"
    },
    "sqlSuccess": {
      "type": "boolean",
      "default": true,
      "title": "SQL Success"
    },
    "dataSufficiencyScore": {
      "type": "number",
      "default": 0,
      "title": "Data Sufficiency Score"
    },
    "dataSufficiencyStatus": {
      "type": "string",
      "enum": [
        "strong",
        "partial",
        "limited",
        "insufficient"
      ],
      "title": "Data Sufficiency Status"
    },
    "missingFields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Missing Fields"
    },
    "confidenceScore": {
      "type": "number",
      "default": 0,
      "title": "Confidence Score"
    },
    "answerQualityScore": {
      "type": "number",
      "default": 0,
      "title": "Answer Quality Score"
    },
    "fallbackReason": {
      "type": "string",
      "title": "Fallback Reason"
    },
    "finalAnswer": {
      "type": "object",
      "title": "Final Answer (JSON)",
      "additionalProperties": true
    },
    "qualityBreakdown": {
      "type": "object",
      "title": "Quality Breakdown",
      "additionalProperties": true
    },
    "feedbackRating": {
      "type": "string",
      "enum": [
        "useful",
        "improve",
        "incorrect",
        "missing_data",
        ""
      ],
      "title": "Feedback Rating"
    },
    "durationMs": {
      "type": "number",
      "default": 0,
      "title": "Duration (ms)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "title": "Timestamp"
    }
  },
  "required": [
    "agentName",
    "userQuestion"
  ]
}