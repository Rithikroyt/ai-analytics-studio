{
  "name": "VerifiedAnswer",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "title": "Question"
    },
    "verifiedSql": {
      "type": "string",
      "title": "Verified SQL Query"
    },
    "expectedAnswerPattern": {
      "type": "string",
      "title": "Expected Answer Pattern or Summary"
    },
    "expectedAnswer": {
      "type": "string",
      "title": "Expected Answer"
    },
    "metricUsed": {
      "type": "string",
      "title": "Primary Metric Used"
    },
    "metricsUsed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "All Metrics Used"
    },
    "domain": {
      "type": "string",
      "enum": [
        "finance",
        "growth",
        "operations",
        "quality",
        "forecast",
        "strategy",
        "general"
      ],
      "title": "Domain"
    },
    "owner": {
      "type": "string",
      "title": "Owner Email"
    },
    "status": {
      "type": "string",
      "enum": [
        "certified",
        "draft",
        "deprecated"
      ],
      "default": "draft",
      "title": "Status"
    },
    "lastReviewed": {
      "type": "string",
      "format": "date",
      "title": "Last Reviewed Date"
    },
    "reviewedBy": {
      "type": "string",
      "title": "Reviewed By (email)"
    },
    "timesUsed": {
      "type": "number",
      "default": 0,
      "title": "Times Used in Queries"
    },
    "datasetId": {
      "type": "string",
      "title": "Associated Dataset ID"
    },
    "datasetName": {
      "type": "string",
      "title": "Associated Dataset Name"
    },
    "accuracy": {
      "type": "number",
      "title": "Known accuracy (0-100)"
    },
    "confidenceScore": {
      "type": "number",
      "title": "Confidence Score (0-100)"
    },
    "businessImpact": {
      "type": "string",
      "title": "Business impact of this answer"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Known limitations"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Tags for discovery"
    },
    "notes": {
      "type": "string",
      "title": "Additional context"
    }
  },
  "required": [
    "question",
    "metricUsed"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}