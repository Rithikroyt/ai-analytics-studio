{
  "name": "ColumnProfile",
  "type": "object",
  "properties": {
    "datasetVersionId": {
      "type": "string",
      "title": "Dataset Version ID"
    },
    "dataSourceId": {
      "type": "string",
      "title": "Data Source ID"
    },
    "columnName": {
      "type": "string",
      "title": "Column Name"
    },
    "originalName": {
      "type": "string",
      "title": "Original Name"
    },
    "standardizedName": {
      "type": "string",
      "title": "Standardized Name"
    },
    "detectedType": {
      "type": "string",
      "enum": [
        "string",
        "number",
        "integer",
        "date",
        "boolean",
        "category",
        "currency",
        "percentage",
        "id",
        "geo",
        "unknown"
      ],
      "title": "Detected Type"
    },
    "semanticRole": {
      "type": "string",
      "enum": [
        "metric",
        "dimension",
        "id",
        "date",
        "geo",
        "target",
        "text",
        "flag",
        "unknown"
      ],
      "title": "Semantic Role"
    },
    "missingCount": {
      "type": "number",
      "default": 0,
      "title": "Missing Count"
    },
    "missingRate": {
      "type": "number",
      "default": 0,
      "title": "Missing Rate"
    },
    "uniqueCount": {
      "type": "number",
      "default": 0,
      "title": "Unique Count"
    },
    "uniqueRate": {
      "type": "number",
      "default": 0,
      "title": "Unique Rate"
    },
    "min": {
      "type": "string",
      "title": "Min Value"
    },
    "max": {
      "type": "string",
      "title": "Max Value"
    },
    "mean": {
      "type": "number",
      "title": "Mean"
    },
    "median": {
      "type": "number",
      "title": "Median"
    },
    "mode": {
      "type": "string",
      "title": "Mode"
    },
    "stdDev": {
      "type": "number",
      "title": "Std Dev"
    },
    "outlierCount": {
      "type": "number",
      "default": 0,
      "title": "Outlier Count"
    },
    "isKpiCandidate": {
      "type": "boolean",
      "default": false,
      "title": "KPI Candidate"
    },
    "isDateCandidate": {
      "type": "boolean",
      "default": false,
      "title": "Date Candidate"
    },
    "isGeoCandidate": {
      "type": "boolean",
      "default": false,
      "title": "Geo Candidate"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Warnings"
    },
    "recommendedFixes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Recommended Fixes"
    }
  },
  "required": [
    "dataSourceId",
    "columnName"
  ]
}