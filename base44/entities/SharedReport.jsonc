{
  "name": "SharedReport",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Report Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "reportType": {
      "type": "string",
      "title": "Report Type"
    },
    "content": {
      "type": "string",
      "title": "Report Content (JSON or Markdown)"
    },
    "dataSnapshot": {
      "type": "object",
      "title": "Data Snapshot",
      "additionalProperties": true
    },
    "accessLevel": {
      "type": "string",
      "title": "Access Level",
      "enum": [
        "view",
        "comment",
        "edit"
      ],
      "default": "view"
    },
    "invitedEmails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Invited Emails"
    },
    "shareToken": {
      "type": "string",
      "title": "Share Token"
    },
    "isPublic": {
      "type": "boolean",
      "title": "Public Link",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    },
    "datasetName": {
      "type": "string",
      "title": "Source Dataset"
    },
    "tableName": {
      "type": "string",
      "title": "Table Name (legacy)"
    },
    "qualityScore": {
      "type": "number",
      "title": "Quality Score"
    },
    "confidenceScore": {
      "type": "number",
      "title": "Confidence Score (0-100)"
    },
    "kpiValue": {
      "type": "string",
      "title": "Primary KPI"
    },
    "createdBy": {
      "type": "string",
      "title": "Created By Email"
    }
  },
  "required": [
    "title"
  ]
}