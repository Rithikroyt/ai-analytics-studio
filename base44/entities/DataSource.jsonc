{
  "name": "DataSource",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Dataset Name"
    },
    "fileType": {
      "type": "string",
      "enum": [
        "csv",
        "xlsx",
        "json",
        "api",
        "demo"
      ],
      "title": "File Type"
    },
    "fileUrl": {
      "type": "string",
      "title": "Raw File URL"
    },
    "cleanedFileUrl": {
      "type": "string",
      "title": "Cleaned File URL"
    },
    "activeVersionId": {
      "type": "string",
      "title": "Active Version ID"
    },
    "rowCount": {
      "type": "number",
      "default": 0,
      "title": "Row Count"
    },
    "columnCount": {
      "type": "number",
      "default": 0,
      "title": "Column Count"
    },
    "qualityScore": {
      "type": "number",
      "default": 0,
      "title": "Quality Score (0-100)"
    },
    "readinessScore": {
      "type": "number",
      "default": 0,
      "title": "Readiness Score (0-100)"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "domain": {
      "type": "string",
      "enum": [
        "sales",
        "marketing",
        "finance",
        "hr",
        "healthcare",
        "supply_chain",
        "operations",
        "general"
      ],
      "title": "Domain"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Tags"
    },
    "status": {
      "type": "string",
      "enum": [
        "uploading",
        "processing",
        "ready",
        "error",
        "cleaned",
        "analyzed"
      ],
      "default": "uploading",
      "title": "Status"
    },
    "uploadedBy": {
      "type": "string",
      "title": "Uploaded By"
    },
    "fileName": {
      "type": "string",
      "title": "Original File Name"
    },
    "sheetName": {
      "type": "string",
      "title": "Sheet Name (XLSX)"
    }
  },
  "required": [
    "name",
    "fileType"
  ]
}